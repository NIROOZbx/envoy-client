// ============================================================
// APPTICS — SaaS Landing Page UI Specification
// Generated by: Senior UI/UX → Developer Handoff
// Target: Tailwind CSS v3 | React | Light + Dark mode
// Page type: Marketing landing page (full-scroll, single page)
// ============================================================

{

  // ─────────────────────────────────────────────
  // 1. COLOR SYSTEM
  // 2 palettes only: primary (blue/cyan electric) + secondary (neutral/warm gray)
  // ─────────────────────────────────────────────
  "colors": {

    "primary": {
      // Electric blue — extracted from "Subscribers" word, CTA button,
      // chart bars, feature icons, badge highlights
      "50":  "#eff6ff",
      "100": "#dbeafe",
      "200": "#bfdbfe",
      "300": "#93c5fd",
      "400": "#60a5fa",
      "500": "#3b82f6",   // base brand blue — icon fills, chart bars
      "600": "#2563eb",   // CTA button bg, strong accents
      "700": "#1d4ed8",   // button hover
      "800": "#1e40af",
      "900": "#1e3a8a",
      "DEFAULT": "#3b82f6",

      // Secondary accent within primary family — cyan/teal used in growth chart
      "cyan": "#06b6d4",  // chart bar accent, "Grow" word highlight

      // Green accent — "Powerhouse" word highlight, growth indicators
      "green": "#22c55e",

      // Gradient variants
      "gradient": {
        "heroWord": "from-blue-500 to-cyan-400",      // "Subscribers" text gradient
        "ctaButton": "from-blue-600 to-blue-500",     // CTA button
        "chartBars": "from-green-400 to-cyan-400"     // revenue bar chart
      }
    },

    "secondary": {
      // Warm neutral — page bg, card surfaces, text hierarchy
      "50":  "#fafafa",   // page background — almost white, very slight warm tint
      "100": "#f5f5f5",   // section alternating bg (features section)
      "200": "#e5e5e5",   // dividers, borders
      "300": "#d4d4d4",   // subtle borders on cards
      "400": "#a3a3a3",   // secondary/muted text, placeholder
      "500": "#737373",   // body text, descriptions
      "600": "#525252",   // stronger body text
      "700": "#404040",   // subheadings
      "800": "#262626",   // headings
      "900": "#171717",   // darkest text, dark mode surface
      "950": "#0a0a0a",   // dark mode page bg
      "DEFAULT": "#737373"
    },

    // Semantic / functional colors (not a third palette — extracted from UI)
    "semantic": {
      "success": "#22c55e",     // green — growth indicators, positive stats
      "info": "#3b82f6",        // blue — info badges
      "warning": "#f59e0b",     // amber — not clearly present but implied
      "white": "#ffffff",
      "overlayCard": "rgba(255,255,255,0.85)",  // frosted card bg
      "overlayDark": "rgba(15,15,15,0.85)"      // dark mode frosted card
    }
  },

  // ─────────────────────────────────────────────
  // 2. TYPOGRAPHY
  // Font: Clean geometric sans — very close to Inter or Plus Jakarta Sans
  // Headings use tight tracking, mixed weight
  // ─────────────────────────────────────────────
  "typography": {
    "fontFamily": "font-sans", // Inter or Plus Jakarta Sans recommended
    "tokens": {

      "navBrand": {
        "size": "text-sm",
        "weight": "font-bold",
        "color_light": "text-secondary-900",
        "color_dark": "dark:text-white",
        "tracking": "tracking-tight"
      },

      "navLinks": {
        "size": "text-sm",
        "weight": "font-medium",
        "color_light": "text-secondary-600",
        "color_dark": "dark:text-secondary-300",
        "hover": "hover:text-secondary-900 dark:hover:text-white",
        "gap": "gap-6"
      },

      "heroBadge": {
        // "Built For Shopify" pill badge above headline
        "size": "text-xs",
        "weight": "font-medium",
        "color": "text-primary-600 dark:text-primary-400",
        "bg_light": "bg-primary-50",
        "bg_dark": "dark:bg-primary-900/30",
        "border": "border border-primary-200 dark:border-primary-700",
        "borderRadius": "rounded-full",
        "padding": "px-3 py-1"
      },

      "heroHeadingLine1": {
        // "Turn Your Shoppers"
        "size": "text-5xl lg:text-6xl",  // ~48–60px
        "weight": "font-bold",
        "color_light": "text-secondary-900",
        "color_dark": "dark:text-white",
        "tracking": "tracking-tight",
        "lineHeight": "leading-tight"
      },

      "heroHeadingLine2": {
        // "into 🔵 Subscribers" — "Subscribers" is gradient colored
        "size": "text-5xl lg:text-6xl",
        "weight": "font-bold",
        "tracking": "tracking-tight",
        "lineHeight": "leading-tight",
        "plainText": "into ",
        "icon": "inline emoji/icon between 'into' and 'Subscribers'",
        "gradientWord": {
          "text": "Subscribers",
          "classes": "bg-gradient-to-r from-blue-500 to-cyan-400 bg-clip-text text-transparent"
        }
      },

      "heroSubtitle": {
        "size": "text-base lg:text-lg",
        "weight": "font-normal",
        "color_light": "text-secondary-500",
        "color_dark": "dark:text-secondary-400",
        "maxWidth": "max-w-md mx-auto",
        "align": "text-center",
        "lineHeight": "leading-relaxed"
      },

      "sectionLabel": {
        // Small uppercase label above section headings e.g. "Features"
        "size": "text-xs",
        "weight": "font-semibold",
        "tracking": "tracking-widest uppercase",
        "color_light": "text-secondary-400",
        "color_dark": "dark:text-secondary-500",
        "marginBottom": "mb-3"
      },

      "sectionHeading": {
        // "Transform Your eCom Store into a Subscription 🔵 Powerhouse"
        "size": "text-3xl lg:text-4xl",
        "weight": "font-bold",
        "color_light": "text-secondary-900",
        "color_dark": "dark:text-white",
        "tracking": "tracking-tight",
        "align": "text-center",
        "maxWidth": "max-w-2xl mx-auto",
        "gradientWord": {
          // "Powerhouse" has green/blue gradient similar to hero
          "classes": "bg-gradient-to-r from-green-400 to-cyan-400 bg-clip-text text-transparent"
        }
      },

      "sectionSubtitle": {
        "size": "text-sm lg:text-base",
        "weight": "font-normal",
        "color_light": "text-secondary-500",
        "color_dark": "dark:text-secondary-400",
        "align": "text-center",
        "maxWidth": "max-w-xl mx-auto",
        "lineHeight": "leading-relaxed"
      },

      "featureCardTitle": {
        "size": "text-base",
        "weight": "font-semibold",
        "color_light": "text-secondary-800",
        "color_dark": "dark:text-secondary-100"
      },

      "featureCardBody": {
        "size": "text-sm",
        "weight": "font-normal",
        "color_light": "text-secondary-500",
        "color_dark": "dark:text-secondary-400",
        "lineHeight": "leading-relaxed"
      },

      "integrationLabel": {
        // "Seamless Integration Across all Your Apps"
        "size": "text-sm",
        "weight": "font-medium",
        "color_light": "text-secondary-500",
        "color_dark": "dark:text-secondary-400",
        "align": "text-center"
      },

      "statValue": {
        // Revenue numbers in charts e.g. "$1,154,341.50"
        "size": "text-xl font-bold",
        "color_light": "text-secondary-900",
        "color_dark": "dark:text-white"
      },

      "ctaButtonLabel": {
        "size": "text-sm",
        "weight": "font-semibold",
        "color": "text-white",
        "tracking": "tracking-wide"
      }
    }
  },

  // ─────────────────────────────────────────────
  // 3. LAYOUT & SPACING
  // ─────────────────────────────────────────────
  "layout": {

    "page": {
      "bg_light": "bg-secondary-50",
      "bg_dark": "dark:bg-secondary-950",
      "fontAntialiasing": "antialiased"
    },

    "container": {
      "maxWidth": "max-w-6xl",     // ~1152px content max
      "margin": "mx-auto",
      "padding": "px-4 sm:px-6 lg:px-8"
    },

    "sections": {
      "verticalSpacing": "py-16 lg:py-24",  // consistent section padding
      "innerGap": "gap-12 lg:gap-16"
    },

    "navbar": {
      "height": "h-14 lg:h-16",
      "position": "sticky top-0 z-50",
      "bg_light": "bg-white/80 backdrop-blur-md",
      "bg_dark": "dark:bg-secondary-900/80 dark:backdrop-blur-md",
      "border_light": "border-b border-secondary-200",
      "border_dark": "dark:border-secondary-700",
      "layout": "flex items-center justify-between",
      "padding": "px-4 sm:px-6 lg:px-8"
    }
  },

  // ─────────────────────────────────────────────
  // 4. SECTIONS (top to bottom)
  // ─────────────────────────────────────────────
  "sections": {

    // ── S1. Navbar ─────────────────────────────
    "navbar": {
      "left": "brand logo — 'apptics' wordmark in bold",
      "center": "nav links: Features | Onboarding | Calculator | FAQs — hidden on mobile",
      "right": "'Book a Call' CTA button",
      "mobileMenu": "hamburger on < md, collapses links into dropdown",

      "bookCallButton": {
        "height": "h-8",
        "padding": "px-4",
        "borderRadius": "rounded-lg",
        "bg_light": "bg-secondary-900",
        "bg_dark": "dark:bg-white",
        "text_light": "text-white text-sm font-medium",
        "text_dark": "dark:text-secondary-900",
        "hover_light": "hover:bg-secondary-700",
        "hover_dark": "dark:hover:bg-secondary-100"
      }
    },

    // ── S2. Hero Section ───────────────────────
    "hero": {
      "layout": "flex flex-col items-center text-center",
      "paddingTop": "pt-20 lg:pt-28",
      "paddingBottom": "pb-16 lg:pb-20",
      "bg_light": "bg-white",
      "bg_dark": "dark:bg-secondary-950",

      "badge": {
        // "Built For Shopify" badge with Shopify bag icon
        "layout": "inline-flex items-center gap-1.5",
        "borderRadius": "rounded-full",
        "padding": "px-3 py-1",
        "bg_light": "bg-secondary-100",
        "bg_dark": "dark:bg-secondary-800",
        "text_light": "text-secondary-600 text-xs font-medium",
        "text_dark": "dark:text-secondary-300",
        "icon": "Shopify bag icon — 16x16 — green (#96BF48)"
      },

      "headline": {
        "marginTop": "mt-4",
        "gap": "space-y-1",
        // Line 1: "Turn Your Shoppers" — black
        // Line 2: "into [icon] Subscribers" — "Subscribers" is gradient
        "inlineIcon": {
          // Small blue square/shield icon between "into" and "Subscribers"
          "size": "w-10 h-10 inline-block align-middle mx-1",
          "borderRadius": "rounded-lg",
          "bg": "bg-primary-600",
          "iconColor": "text-white"
        }
      },

      "subtitle": {
        "marginTop": "mt-4",
        "text": "Everything you need to create and grow your subscriptions, all in one place."
      },

      "ctaButton": {
        "marginTop": "mt-8",
        "layout": "inline-flex items-center gap-2",
        "height": "h-11",
        "padding": "px-6",
        "borderRadius": "rounded-xl",
        "bg": "bg-secondary-900 dark:bg-white",
        "text": "text-white dark:text-secondary-900 text-sm font-semibold",
        "shadow": "shadow-lg shadow-secondary-900/20",
        "hover": "hover:bg-secondary-700 dark:hover:bg-secondary-100",
        "trailingIcon": "arrow-right or chevron — w-4 h-4",
        "label": "Generate My MRR" // or similar CTA text
      },

      "heroVisual": {
        // Floating dashboard cards / UI mockup illustration
        // Positioned below CTA, centered
        // Contains: subscriber count cards, avatar clusters, floating stat pills
        "marginTop": "mt-12 lg:mt-16",
        "layout": "relative w-full max-w-3xl mx-auto",
        "height": "h-64 lg:h-80",
        "description": [
          "Central vertical blue line/spine — w-0.5 bg-primary-500 h-full absolute left-1/2",
          "Floating card: 'New Subscriber' — top right — white card, avatar, green dot",
          "Floating card: subscriber avatars cluster — top left area",
          "Floating pill: 'New Subscriber' notification — bottom right",
          "Floating card: stat block — bottom left",
          "All cards have: bg-white shadow-xl rounded-2xl p-3"
        ],
        "floatingCard": {
          "bg_light": "bg-white",
          "bg_dark": "dark:bg-secondary-800",
          "shadow": "shadow-xl shadow-secondary-200/50 dark:shadow-secondary-900/50",
          "borderRadius": "rounded-2xl",
          "border_light": "border border-secondary-100",
          "border_dark": "dark:border-secondary-700",
          "padding": "p-3 lg:p-4"
        }
      }
    },

    // ── S3. Integration Logos ──────────────────
    "integrations": {
      "bg_light": "bg-secondary-50",
      "bg_dark": "dark:bg-secondary-900",
      "paddingY": "py-10",
      "label": "Seamless Integration Across all Your Apps",
      "labelStyle": "text-sm text-center text-secondary-400 mb-6",

      "logoStrip": {
        "layout": "flex items-center justify-center flex-wrap gap-8 lg:gap-12",
        "logos": [
          { "name": "Shopify", "style": "text-2xl font-bold text-secondary-800 dark:text-secondary-100", "type": "wordmark" },
          { "name": "WooCommerce", "style": "text-secondary-600", "color": "#7F54B3", "type": "wordmark+logo" },
          { "name": "nmi", "color": "#00A651", "type": "wordmark" },
          { "name": "PayPal", "color": "#003087", "type": "wordmark" },
          { "name": "Checkout (partial)", "type": "wordmark — cropped at edge suggesting overflow/marquee" }
        ],
        "logoHeight": "h-6 lg:h-7",
        "opacity_light": "opacity-70 hover:opacity-100",
        "opacity_dark": "dark:opacity-50 dark:hover:opacity-80",
        "transition": "transition-opacity duration-200",
        "note": "Consider infinite marquee animation on mobile — logos overflow right edge suggesting this"
      }
    },

    // ── S4. Feature Tabs Section ───────────────
    "featureTabs": {
      "bg_light": "bg-white",
      "bg_dark": "dark:bg-secondary-950",
      "paddingY": "py-16 lg:py-24",

      "heading": "Transform Your eCom Store into a Subscription [icon] Powerhouse",
      "subtext": "Everything you need to build and scale subscriptions — all in one platform.",

      "tabs": {
        // 3 tab cards shown in a horizontal scroll or grid
        "layout": "grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6",
        "marginTop": "mt-12"
      },

      "tabCard": {
        "bg_light": "bg-secondary-50",
        "bg_dark": "dark:bg-secondary-900",
        "borderRadius": "rounded-2xl",
        "border_light": "border border-secondary-200",
        "border_dark": "dark:border-secondary-700",
        "padding": "p-5 lg:p-6",
        "shadow": "shadow-sm",
        "hover": "hover:shadow-md transition-shadow duration-200",

        "tab1": {
          "title": "Create & Manage Subscriptions",
          "body": "Short description text — 2 lines max",
          "visual": {
            // List of subscription plan rows
            "type": "mini list UI",
            "items": [
              "Shopify — $49.99",
              "Shopify — $34.99",
              "Shopify — $34.99"
            ],
            "itemStyle": {
              "layout": "flex items-center gap-2 py-2",
              "icon": "Shopify bag icon — w-5 h-5 rounded bg-secondary-100 p-0.5",
              "text": "text-sm text-secondary-700 dark:text-secondary-300",
              "price": "text-sm font-semibold text-secondary-900 dark:text-white ml-auto"
            }
          }
        },

        "tab2": {
          "title": "Build Custom Checkouts & Upsells",
          "body": "Short description text",
          "visual": {
            // Checkout UI mockup — form fields, button
            "type": "mini checkout form mockup",
            "description": "Simplified card with input fields and a blue submit button",
            "buttonBg": "bg-primary-600",
            "buttonRadius": "rounded-lg"
          }
        },

        "tab3": {
          "title": "Analyze Revenue & Projections",
          "body": "Short description text",
          "visual": {
            // Bar chart showing revenue
            "type": "bar chart",
            "value": "$1,154,341.50",
            "valueStyle": "text-xl font-bold text-secondary-900 dark:text-white",
            "bars": {
              "count": 6,
              "activeBar": {
                "bg": "bg-primary-500",
                "height": "varies — tallest bar is ~70% of chart height"
              },
              "inactiveBar": {
                "bg": "bg-secondary-200 dark:bg-secondary-700"
              },
              "barWidth": "w-6 lg:w-8",
              "borderRadius": "rounded-t-md",
              "gap": "gap-1.5"
            },
            "tooltip": {
              "bg": "bg-primary-500",
              "text": "text-white text-xs",
              "borderRadius": "rounded-md",
              "padding": "px-2 py-1"
            }
          }
        }
      }
    },

    // ── S5. "Built to Help You Grow" ───────────
    "growSection": {
      "bg_light": "bg-secondary-50",
      "bg_dark": "dark:bg-secondary-900",
      "paddingY": "py-16 lg:py-24",

      "heading": "Built to Help You [icon] Grow",
      "gradientWord": {
        "text": "Grow",
        "classes": "bg-gradient-to-r from-green-400 to-cyan-400 bg-clip-text text-transparent"
      },
      "subtext": "One platform to manage subscriptions, integrations, and everything in between.",
      "marginTop": "mt-4",

      "featureGrid": {
        // 2x3 or 3x2 grid of feature cards
        "layout": "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6",
        "marginTop": "mt-12"
      },

      "featureCard": {
        "bg_light": "bg-white",
        "bg_dark": "dark:bg-secondary-800",
        "borderRadius": "rounded-2xl",
        "border_light": "border border-secondary-100",
        "border_dark": "dark:border-secondary-700",
        "padding": "p-5 lg:p-6",
        "shadow": "shadow-sm hover:shadow-md",
        "transition": "transition-shadow duration-200",

        "iconBlock": {
          "size": "w-10 h-10",
          "borderRadius": "rounded-xl",
          "bg": "bg-primary-50 dark:bg-primary-900/30",
          "iconColor": "text-primary-600 dark:text-primary-400",
          "marginBottom": "mb-4"
        },

        "cards": [
          {
            "id": "card1",
            "title": "Predictable, Recurring Revenue",
            "visual": {
              "type": "avatar group + line chart",
              "description": "Small circular avatars + subtle green upward line chart overlay",
              "chartColor": "stroke-green-400",
              "avatarBorder": "ring-2 ring-white dark:ring-secondary-800"
            }
          },
          {
            "id": "card2",
            "title": "Real-Time Revenue Insights",
            "visual": {
              "type": "bar chart — green bars",
              "barColor": "bg-green-400",
              "description": "Vertical bar chart, all bars green, varying heights",
              "height": "h-20"
            }
          },
          {
            "id": "card3",
            "title": "Fewer Failed Payments",
            "visual": {
              "type": "app screenshot / mockup",
              "description": "Apptics app UI card — purple/blue gradient bg with white card overlay",
              "cardBg": "bg-gradient-to-br from-purple-500 to-blue-500",
              "overlayCard": "bg-white rounded-xl shadow-lg p-3"
            }
          },
          {
            "id": "card4",
            "title": "2X Your Average Order Value",
            "visual": {
              "type": "product grid mockup",
              "description": "Small product cards in a 2-col grid inside the feature card"
            }
          },
          {
            "id": "card5",
            "title": "Less Guesswork, More Growth",
            "visual": {
              "type": "donut/pie chart",
              "description": "Small circular chart — green segment dominant",
              "chartColor": "stroke-green-400",
              "bg": "bg-secondary-50 dark:bg-secondary-900 rounded-full"
            }
          },
          {
            "id": "card6",
            "title": "Enhance Profits From Your Shopify Via Memberships",
            "visual": {
              "type": "CTA button mockup",
              "description": "Dark button: 'Book A Call →' centered in card",
              "buttonBg": "bg-secondary-900 dark:bg-white",
              "buttonText": "text-white dark:text-secondary-900 text-sm font-semibold",
              "buttonRadius": "rounded-xl",
              "buttonPadding": "px-5 py-2.5"
            }
          }
        ]
      }
    }
  },

  // ─────────────────────────────────────────────
  // 5. COMPONENTS
  // ─────────────────────────────────────────────
  "components": {

    "gradientText": {
      // Reusable gradient word component
      "blue-cyan": "bg-gradient-to-r from-blue-500 to-cyan-400 bg-clip-text text-transparent",
      "green-cyan": "bg-gradient-to-r from-green-400 to-cyan-400 bg-clip-text text-transparent",
      "usage": "Wrap any span with these classes + font-bold"
    },

    "floatingCard": {
      // Used in hero illustration
      "bg_light": "bg-white",
      "bg_dark": "dark:bg-secondary-800",
      "border_light": "border border-secondary-100",
      "border_dark": "dark:border-secondary-700",
      "borderRadius": "rounded-2xl",
      "shadow": "shadow-xl",
      "padding": "p-3 lg:p-4",
      "animation": "animate-float or subtle translate-y bounce — CSS keyframe"
    },

    "avatarGroup": {
      // Overlapping circular avatars
      "layout": "flex -space-x-2",
      "avatarSize": "w-8 h-8",
      "borderRadius": "rounded-full",
      "border": "ring-2 ring-white dark:ring-secondary-800",
      "overflow": "overflow-hidden",
      "fallback": "bg-primary-100 text-primary-600 text-xs font-bold flex items-center justify-center"
    },

    "sectionDivider": {
      // Thin horizontal rule between sections
      "color_light": "border-secondary-100",
      "color_dark": "dark:border-secondary-800",
      "style": "border-t"
    },

    "badge": {
      "base": "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium",
      "primary_light": "bg-primary-50 text-primary-700 border border-primary-200",
      "primary_dark": "dark:bg-primary-900/30 dark:text-primary-300 dark:border-primary-700",
      "neutral_light": "bg-secondary-100 text-secondary-600",
      "neutral_dark": "dark:bg-secondary-800 dark:text-secondary-300"
    },

    "logoItem": {
      // Integration logos
      "height": "h-6 lg:h-7",
      "filter_light": "grayscale hover:grayscale-0",
      "filter_dark": "dark:brightness-0 dark:invert dark:hover:brightness-100 dark:hover:invert-0",
      "transition": "transition-all duration-200",
      "opacity": "opacity-60 hover:opacity-100"
    }
  },

  // ─────────────────────────────────────────────
  // 6. RESPONSIVE BREAKPOINTS
  // Tailwind defaults: sm:640 md:768 lg:1024 xl:1280 2xl:1536
  // ─────────────────────────────────────────────
  "responsive": {

    "xs_default": {
      // < 640px — mobile first
      "navbar": "logo left + hamburger right. Nav links hidden.",
      "hero": {
        "headingSize": "text-4xl",
        "layout": "flex-col items-center text-center px-4",
        "heroVisual": "hidden or simplified — floating cards stack vertically"
      },
      "integrationLogos": "flex-wrap justify-center gap-6 — 2-3 per row",
      "featureTabsGrid": "grid-cols-1 — stacked vertically",
      "growGrid": "grid-cols-1 — stacked vertically",
      "container": "px-4"
    },

    "sm_640": {
      "growGrid": "grid-cols-2 — 2 columns",
      "featureTabsGrid": "grid-cols-1 — still single col until md",
      "container": "px-6"
    },

    "md_768": {
      "navbar": "all nav links visible",
      "featureTabsGrid": "grid-cols-3 — 3 columns side by side",
      "hero": {
        "headingSize": "text-5xl",
        "heroVisual": "show full floating card illustration"
      }
    },

    "lg_1024": {
      "growGrid": "grid-cols-3",
      "hero": {
        "headingSize": "text-6xl",
        "paddingTop": "pt-28"
      },
      "container": "px-8"
    },

    "xl_1280": {
      "container": "max-w-6xl mx-auto — centered, no further width growth"
    },

    "notes": [
      "Integration logo strip likely uses a CSS marquee/infinite scroll on mobile",
      "Feature tab cards on mobile should be horizontally scrollable (overflow-x-auto snap-x)",
      "Hero illustration floating cards collapse to a static screenshot on mobile",
      "Navbar CTA 'Book a Call' remains visible at all breakpoints"
    ]
  },

  // ─────────────────────────────────────────────
  // 7. DARK MODE
  // Strategy: class-based (darkMode: 'class' in tailwind.config)
  // ─────────────────────────────────────────────
  "darkMode": {
    "strategy": "class",
    "pageBackground": "dark:bg-secondary-950",
    "navBackground": "dark:bg-secondary-900/80 dark:backdrop-blur-md dark:border-secondary-700",
    "heroBackground": "dark:bg-secondary-950",
    "headingText": "dark:text-white",
    "bodyText": "dark:text-secondary-400",
    "labelText": "dark:text-secondary-300",
    "cardBg": "dark:bg-secondary-800",
    "cardBorder": "dark:border-secondary-700",
    "tabCardBg": "dark:bg-secondary-900",
    "sectionAltBg": "dark:bg-secondary-900",
    "integrationSection": "dark:bg-secondary-900",
    "logoFilter": "dark:brightness-0 dark:invert",
    "barChart_inactiveBars": "dark:bg-secondary-700",
    "gradientText": "no change — gradient is visible in both modes",
    "ctaButton": {
      "light": "bg-secondary-900 text-white",
      "dark": "dark:bg-white dark:text-secondary-900"
    },
    "bookCallButton": {
      "light": "bg-secondary-900 text-white",
      "dark": "dark:bg-white dark:text-secondary-900"
    },
    "floatingCards": "dark:bg-secondary-800 dark:border-secondary-700 dark:shadow-secondary-900/50",
    "featureIconBlock": "dark:bg-primary-900/30 dark:text-primary-400"
  },

  // ─────────────────────────────────────────────
  // 8. ANIMATION & MOTION
  // ─────────────────────────────────────────────
  "animation": {
    "heroFloatingCards": {
      "type": "CSS keyframe float",
      "keyframe": "0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)}",
      "duration": "duration-3000",
      "timing": "ease-in-out",
      "iteration": "infinite",
      "stagger": "each card offset by 500ms for organic feel"
    },
    "logoMarquee": {
      "type": "infinite horizontal scroll",
      "direction": "left",
      "speed": "20s linear infinite",
      "pauseOnHover": true
    },
    "cardHover": {
      "shadow": "hover:shadow-md transition-shadow duration-200"
    },
    "ctaButtonHover": {
      "scale": "hover:scale-[1.02] active:scale-[0.98]",
      "transition": "transition-transform duration-150"
    },
    "sectionEntrance": {
      "type": "fade-up on scroll",
      "recommended": "use Intersection Observer or framer-motion",
      "initial": "opacity-0 translate-y-4",
      "animate": "opacity-100 translate-y-0",
      "duration": "duration-500",
      "easing": "ease-out"
    }
  },

  // ─────────────────────────────────────────────
  // 9. TAILWIND CONFIG EXTENSIONS
  // ─────────────────────────────────────────────
  "tailwindConfigExtend": {
    "darkMode": "class",
    "colors": {
      "primary": {
        "50":  "#eff6ff",
        "100": "#dbeafe",
        "200": "#bfdbfe",
        "300": "#93c5fd",
        "400": "#60a5fa",
        "500": "#3b82f6",
        "600": "#2563eb",
        "700": "#1d4ed8",
        "800": "#1e40af",
        "900": "#1e3a8a",
        "cyan": "#06b6d4",
        "green": "#22c55e",
        "DEFAULT": "#3b82f6"
      },
      "secondary": {
        "50":  "#fafafa",
        "100": "#f5f5f5",
        "200": "#e5e5e5",
        "300": "#d4d4d4",
        "400": "#a3a3a3",
        "500": "#737373",
        "600": "#525252",
        "700": "#404040",
        "800": "#262626",
        "900": "#171717",
        "950": "#0a0a0a",
        "DEFAULT": "#737373"
      }
    },
    "keyframes": {
      "float": {
        "0%, 100%": { "transform": "translateY(0px)" },
        "50%": { "transform": "translateY(-8px)" }
      },
      "marquee": {
        "0%": { "transform": "translateX(0%)" },
        "100%": { "transform": "translateX(-50%)" }
      }
    },
    "animation": {
      "float": "float 3s ease-in-out infinite",
      "marquee": "marquee 20s linear infinite"
    },
    "fontFamily": {
      "sans": ["Inter", "Plus Jakarta Sans", "system-ui", "sans-serif"]
    }
  },

  // ─────────────────────────────────────────────
  // 10. OBSERVATIONS & NOTES
  // ─────────────────────────────────────────────
  "observations": {
    "overallStyle": "Clean SaaS marketing page. Lots of white space. Cards float on subtle backgrounds. Gradient text used sparingly for impact words only.",
    "backgroundStrategy": "Alternating section backgrounds: hero=white, integrations=gray-50, features=white, grow=gray-50. Creates rhythm without borders.",
    "gradientWords": "Only 2-3 words per page get gradient treatment — 'Subscribers', 'Powerhouse', 'Grow'. This restraint is intentional and should be preserved.",
    "heroIllustration": "The floating dashboard cards in the hero are the most complex element. Build as absolutely positioned divs with z-index layering. Use framer-motion for the float animation.",
    "logoStrip": "Integration logos likely have a CSS marquee on mobile. On desktop they're static flex row. Implement both behaviors.",
    "featureCardVisuals": "Each of the 3 feature tab cards contains a mini UI mockup — not icons, not illustrations, but actual simplified UI components. This is the hardest part to implement faithfully.",
    "growSection6thCard": "The 6th 'Enhance Profits' card contains an actual dark CTA button inside the card — it's a call to action nested inside a feature card. Intentional — treat it as a mini CTA.",
    "typography": "No evidence of a custom font. Inter fits perfectly. Heading weights are bold (700), not black (900).",
    "shadows": "Shadows are very subtle throughout (shadow-sm on most cards, shadow-xl only on floating hero cards). Avoid heavy shadows.",
    "borderRadius": "Consistent rounded-2xl (16px) on all cards. rounded-xl (12px) on buttons. rounded-lg (8px) on inputs inside mockups.",
    "iconStyle": "Icons are solid/filled, not outline. Shopify bag icon used multiple times. Feature section icons in colored bg blocks."
  }
}
