// ============================================================
// ENVOY — Signup Form UI Specification
// Generated by: Senior UI/UX → Developer Handoff
// Target: Tailwind CSS v3 | React | Light + Dark mode
// ============================================================

{
  // ─────────────────────────────────────────────
  // 1. COLOR SYSTEM
  // Only 2 palettes: primary (crimson/rose) + secondary (neutral/gray)
  // Maps directly to Tailwind custom color tokens
  // ─────────────────────────────────────────────
  "colors": {

    "primary": {
      // Rose-Crimson — extracted from the CTA button gradient
      "50":  "#fff1f3",   // lightest tint — hover bg, pill backgrounds
      "100": "#ffe0e5",
      "200": "#ffc5cf",
      "300": "#ff96a8",
      "400": "#ff5c78",   // button hover state
      "500": "#f52d55",   // base brand — CTA button left stop
      "600": "#d81b4a",   // button right stop / gradient end
      "700": "#b5143c",   // pressed state, focus rings
      "800": "#961232",
      "900": "#7c122c",
      "DEFAULT": "#f52d55"
    },

    "secondary": {
      // Neutral gray — all surface, border, text colors
      "50":  "#f9fafb",   // page background (light mode)
      "100": "#f3f4f6",   // card surface (light mode)
      "200": "#e5e7eb",   // borders, dividers
      "300": "#d1d5db",   // input borders (default state)
      "400": "#9ca3af",   // placeholder text, icon color
      "500": "#6b7280",   // secondary body text ("Welcome! Fill in...")
      "600": "#4b5563",   // label text ("First name", "Email address")
      "700": "#374151",   // strong body text
      "800": "#1f2937",   // heading text in light mode ("Create your account")
      "900": "#111827",   // darkest — heading in dark mode
      "950": "#0d1117",   // page bg in dark mode
      "DEFAULT": "#6b7280"
    }
  },

  // ─────────────────────────────────────────────
  // 2. TYPOGRAPHY
  // Font: System UI stack (no custom font detected)
  // Very close to Inter or -apple-system
  // ─────────────────────────────────────────────
  "typography": {
    "fontFamily": "font-sans", // Tailwind default: Inter / system-ui
    "tokens": {
      "heading": {
        "text": "Create your account",
        "size": "text-2xl",          // ~24px
        "weight": "font-semibold",   // 600
        "color_light": "text-secondary-800",
        "color_dark": "text-secondary-50",
        "tracking": "tracking-tight",
        "align": "text-center"
      },
      "subheading": {
        "text": "Welcome! Please fill in the details to get started.",
        "size": "text-sm",           // ~14px
        "weight": "font-normal",
        "color_light": "text-secondary-500",
        "color_dark": "text-secondary-400",
        "align": "text-center",
        "marginTop": "mt-1"
      },
      "label": {
        "size": "text-sm",           // ~14px
        "weight": "font-medium",     // 500
        "color_light": "text-secondary-600",
        "color_dark": "text-secondary-300",
        "marginBottom": "mb-1.5"
      },
      "placeholder": {
        "size": "text-sm",
        "color": "placeholder:text-secondary-400"
      },
      "oauthButtonLabel": {
        "size": "text-sm",
        "weight": "font-medium",
        "color_light": "text-secondary-700",
        "color_dark": "text-secondary-200"
      },
      "dividerText": {
        "text": "or",
        "size": "text-xs",
        "weight": "font-normal",
        "color_light": "text-secondary-400",
        "color_dark": "text-secondary-500",
        "padding": "px-3"
      },
      "ctaButtonLabel": {
        "text": "Continue",
        "size": "text-sm",
        "weight": "font-semibold",
        "color": "text-white",
        "tracking": "tracking-wide"
      },
      "checkboxLabel": {
        "size": "text-sm",
        "color_light": "text-secondary-600",
        "color_dark": "text-secondary-400"
      },
      "link": {
        "color_light": "text-secondary-800",
        "color_dark": "text-secondary-100",
        "decoration": "underline underline-offset-2",
        "weight": "font-medium"
      },
      "footerText": {
        "text": "Already have an account?",
        "size": "text-sm",
        "color_light": "text-secondary-500",
        "color_dark": "text-secondary-400"
      },
      "footerLink": {
        "text": "Sign in",
        "size": "text-sm",
        "weight": "font-semibold",
        "color_light": "text-secondary-800",
        "color_dark": "text-secondary-100",
        "marginLeft": "ml-1"
      }
    }
  },

  // ─────────────────────────────────────────────
  // 3. SPACING & LAYOUT
  // ─────────────────────────────────────────────
  "layout": {
    "page": {
      "display": "flex flex-col items-center justify-center min-h-screen",
      "bg_light": "bg-secondary-50",
      "bg_dark": "dark:bg-secondary-950",
      "padding": "px-4 py-8"
    },
    "card": {
      "width": "w-full max-w-[420px]",   // extracted: ~420px max, fluid below
      "bg_light": "bg-white",
      "bg_dark": "dark:bg-secondary-900",
      "borderRadius": "rounded-2xl",     // ~16px, prominent rounding
      "shadow": "shadow-sm",             // very subtle shadow, barely visible
      "border_light": "border border-secondary-200",
      "border_dark": "dark:border-secondary-700",
      "padding": "px-8 py-10",           // ~32px horizontal, ~40px vertical
      "gap": "space-y-6"                 // consistent 24px between major sections
    },
    "footer": {
      // "Already have an account? Sign in" — outside the card
      "marginTop": "mt-6",
      "display": "flex items-center justify-center"
    }
  },

  // ─────────────────────────────────────────────
  // 4. COMPONENTS
  // ─────────────────────────────────────────────
  "components": {

    // ── 4.1 OAuth Buttons ──────────────────────
    "oauthButton": {
      "layout": "flex items-center justify-center gap-2.5",
      "width": "w-full",
      "height": "h-10",                  // ~40px
      "borderRadius": "rounded-lg",      // ~8px
      "border_light": "border border-secondary-300",
      "border_dark": "dark:border-secondary-600",
      "bg_light": "bg-white",
      "bg_dark": "dark:bg-secondary-800",
      "shadow": "shadow-sm",
      "hover_light": "hover:bg-secondary-50",
      "hover_dark": "dark:hover:bg-secondary-700",
      "transition": "transition-colors duration-150",
      "cursor": "cursor-pointer",
      "padding": "px-4",

      "githubButton": {
        "icon": {
          // GitHub Octocat SVG
          "size": "w-4 h-4",
          "color_light": "text-secondary-900",
          "color_dark": "dark:text-secondary-100"
        },
        "label": "GitHub"
      },
      "googleButton": {
        "icon": {
          // Google multicolor SVG (use official SVG, not icon font)
          // Colors: #4285F4 (blue), #34A853 (green), #FBBC05 (yellow), #EA4335 (red)
          "size": "w-4 h-4"
        },
        "label": "Google"
      },

      "groupLayout": {
        // Two buttons side by side
        "display": "grid grid-cols-2 gap-3"
      }
    },

    // ── 4.2 Divider ────────────────────────────
    "divider": {
      "layout": "flex items-center gap-0",
      "line_light": "flex-1 h-px bg-secondary-200",
      "line_dark": "dark:bg-secondary-700",
      "text": "px-3 text-xs text-secondary-400 dark:text-secondary-500"
      // Full: <div class="flex items-center"><div class="flex-1 h-px bg-secondary-200"/><span class="px-3 text-xs text-secondary-400">or</span><div class="flex-1 h-px bg-secondary-200"/></div>
    },

    // ── 4.3 Input Field ────────────────────────
    "inputField": {
      "wrapper": "flex flex-col gap-1.5",
      "label": "text-sm font-medium text-secondary-600 dark:text-secondary-300",
      "input": {
        "height": "h-10",              // ~40px
        "width": "w-full",
        "borderRadius": "rounded-lg",  // ~8px
        "border_light": "border border-secondary-300",
        "border_dark": "dark:border-secondary-600",
        "bg_light": "bg-white",
        "bg_dark": "dark:bg-secondary-800",
        "textColor_light": "text-secondary-800",
        "textColor_dark": "dark:text-secondary-100",
        "placeholder": "placeholder:text-secondary-400",
        "padding": "px-3.5",
        "fontSize": "text-sm",
        "outline": "outline-none",
        "focus": "focus:ring-2 focus:ring-primary-500 focus:border-primary-500",
        "transition": "transition-shadow duration-150",
        "shadow": "shadow-sm"
      },
      "passwordToggleIcon": {
        // Eye icon — right side of password input
        "position": "absolute right-3.5 top-1/2 -translate-y-1/2",
        "size": "w-4 h-4",
        "color_light": "text-secondary-400",
        "color_dark": "dark:text-secondary-500",
        "cursor": "cursor-pointer",
        "hover": "hover:text-secondary-600 dark:hover:text-secondary-300",
        // Wrap input in: <div class="relative">
        "wrapperClass": "relative"
      }
    },

    // ── 4.4 Name Row (two inputs side by side) ─
    "nameRow": {
      "layout": "grid grid-cols-2 gap-3"
      // Each cell is a standard inputField
    },

    // ── 4.5 Checkbox + Label ───────────────────
    "checkbox": {
      "wrapper": "flex items-start gap-2.5",
      "input": {
        "size": "w-4 h-4",
        "marginTop": "mt-0.5",         // vertically align with first line of text
        "borderRadius": "rounded",     // slight rounding — not fully round
        "border_light": "border border-secondary-300",
        "border_dark": "dark:border-secondary-600",
        "bg_light": "bg-white",
        "bg_dark": "dark:bg-secondary-800",
        "accent": "accent-primary-500",  // checked fill color
        "cursor": "cursor-pointer"
      },
      "label": {
        "fontSize": "text-sm",
        "color_light": "text-secondary-600",
        "color_dark": "dark:text-secondary-400",
        "links": {
          // "Terms of Service" and "Privacy Policy"
          "decoration": "underline underline-offset-2",
          "color_light": "text-secondary-800",
          "color_dark": "dark:text-secondary-100",
          "weight": "font-medium"
        }
      }
    },

    // ── 4.6 CTA Button ─────────────────────────
    "ctaButton": {
      "width": "w-full",
      "height": "h-11",                  // ~44px — slightly taller than inputs
      "borderRadius": "rounded-xl",      // ~12px — noticeably more rounded than inputs
      "background": "bg-gradient-to-r from-primary-500 to-primary-600",
      // Extracted gradient: left #f52d55 → right #d81b4a
      // Exact Tailwind approximation: from-rose-500 to-rose-700
      "textColor": "text-white",
      "fontSize": "text-sm",
      "fontWeight": "font-semibold",
      "tracking": "tracking-wide",
      "display": "flex items-center justify-center gap-2",
      "shadow": "shadow-md shadow-primary-500/30",  // colored drop shadow
      "hover": "hover:from-primary-400 hover:to-primary-500",
      "active": "active:scale-[0.98]",
      "transition": "transition-all duration-150",
      "cursor": "cursor-pointer",
      "trailingIcon": {
        // Arrow / play icon on the right side of "Continue"
        "type": "chevron-right or play/arrow",  // small rightward arrow
        "size": "w-4 h-4",
        "color": "text-white/80"
      },

      // Loading state (for async submit)
      "loadingState": {
        "opacity": "opacity-80 cursor-not-allowed",
        "spinner": "animate-spin w-4 h-4 border-2 border-white/30 border-t-white rounded-full"
      }
    }
  },

  // ─────────────────────────────────────────────
  // 5. RESPONSIVE BREAKPOINTS
  // Tailwind defaults: sm:640 md:768 lg:1024 xl:1280 2xl:1536
  // ─────────────────────────────────────────────
  "responsive": {
    "xs_default": {
      // < 640px — mobile
      "card": "w-full rounded-none shadow-none border-none px-5 py-8",
      // On very small screens: card fills full width, no rounding
      "nameRow": "grid-cols-1 gap-3",    // stack first/last name vertically
      "oauthGroup": "grid-cols-1 gap-2"  // stack oauth buttons vertically
    },
    "sm_640": {
      // 640px+ — standard mobile / small tablet
      "card": "w-full max-w-[420px] rounded-2xl border shadow-sm px-8 py-10",
      "nameRow": "grid-cols-2 gap-3",    // side by side restored
      "oauthGroup": "grid-cols-2 gap-3"  // side by side restored
    },
    "md_768": {
      // 768px+ — tablet
      // No structural changes; card stays centered at max-w-[420px]
      "page": "px-6"
    },
    "lg_1024": {
      // 1024px+ — desktop
      // Page could show a split layout (form left, brand illustration right)
      // but current screenshot is form-only — keep card centered
      "page": "px-8"
    },
    "notes": [
      "The card max-width is fixed at 420px across all breakpoints ≥ sm",
      "Below sm, the card becomes a full-bleed form with no card styling",
      "Name row collapses to single column below sm breakpoint",
      "OAuth buttons stack below sm breakpoint"
    ]
  },

  // ─────────────────────────────────────────────
  // 6. DARK MODE STRATEGY
  // Using Tailwind class-based dark mode: darkMode: 'class'
  // Toggle by adding/removing 'dark' class on <html>
  // ─────────────────────────────────────────────
  "darkMode": {
    "strategy": "class",  // tailwind.config: darkMode: 'class'
    "pageBackground": "dark:bg-secondary-950",       // near-black #0d1117
    "cardBackground": "dark:bg-secondary-900",       // #111827
    "cardBorder": "dark:border-secondary-700",
    "inputBackground": "dark:bg-secondary-800",
    "inputBorder": "dark:border-secondary-600",
    "inputText": "dark:text-secondary-100",
    "labelText": "dark:text-secondary-300",
    "headingText": "dark:text-secondary-50",
    "subheadingText": "dark:text-secondary-400",
    "oauthButtonBg": "dark:bg-secondary-800",
    "oauthButtonBorder": "dark:border-secondary-600",
    "oauthButtonHover": "dark:hover:bg-secondary-700",
    "dividerLine": "dark:bg-secondary-700",
    "dividerText": "dark:text-secondary-500",
    "githubIcon": "dark:text-secondary-100",
    "checkboxBorder": "dark:border-secondary-600",
    "checkboxBg": "dark:bg-secondary-800",
    "checkboxLabel": "dark:text-secondary-400",
    "links": "dark:text-secondary-100",
    "footerText": "dark:text-secondary-400",
    "footerLink": "dark:text-secondary-100",
    "ctaButton": "no change — gradient remains identical in dark mode"
    // CTA button color does NOT change in dark mode — primary gradient stays
  },

  // ─────────────────────────────────────────────
  // 7. FORM STRUCTURE (component tree order)
  // ─────────────────────────────────────────────
  "formStructure": {
    "order": [
      "heading",            // "Create your account"
      "subheading",         // "Welcome! Please fill in..."
      "oauthButtonGroup",   // [GitHub] [Google] — grid-cols-2
      "divider",            // ─────── or ───────
      "nameRow",            // [First name] [Last name] — grid-cols-2
      "emailInput",         // full width
      "passwordInput",      // full width + eye toggle
      "checkboxRow",        // [ ] I agree to Terms...
      "ctaButton",          // Continue →
    ],
    "footerOutsideCard": "Already have an account? Sign in"
  },

  // ─────────────────────────────────────────────
  // 8. INTERACTION STATES
  // ─────────────────────────────────────────────
  "interactionStates": {
    "inputFocus": {
      "ring": "focus:ring-2 focus:ring-primary-500/40",
      "border": "focus:border-primary-500",
      "outline": "outline-none"
    },
    "inputError": {
      "border": "border-red-500",
      "ring": "focus:ring-red-500/30",
      "errorMessage": "text-xs text-red-500 mt-1"
    },
    "oauthButtonHover": {
      "bg_light": "hover:bg-secondary-50",
      "bg_dark": "dark:hover:bg-secondary-700",
      "transition": "transition-colors duration-150"
    },
    "ctaButtonHover": {
      "gradient": "hover:from-primary-400 hover:to-primary-500",
      "shadow": "hover:shadow-lg hover:shadow-primary-500/40"
    },
    "ctaButtonActive": {
      "scale": "active:scale-[0.98]",
      "transition": "transition-transform duration-75"
    },
    "checkboxFocus": {
      "ring": "focus:ring-2 focus:ring-primary-500/30 focus:ring-offset-1"
    },
    "linkHover": {
      "opacity": "hover:opacity-70",
      "transition": "transition-opacity duration-100"
    }
  },

  // ─────────────────────────────────────────────
  // 9. TAILWIND CONFIG EXTENSIONS
  // Add to tailwind.config.js → theme.extend
  // ─────────────────────────────────────────────
  "tailwindConfigExtend": {
    "colors": {
      "primary": {
        "50":  "#fff1f3",
        "100": "#ffe0e5",
        "200": "#ffc5cf",
        "300": "#ff96a8",
        "400": "#ff5c78",
        "500": "#f52d55",
        "600": "#d81b4a",
        "700": "#b5143c",
        "800": "#961232",
        "900": "#7c122c",
        "DEFAULT": "#f52d55"
      },
      "secondary": {
        "50":  "#f9fafb",
        "100": "#f3f4f6",
        "200": "#e5e7eb",
        "300": "#d1d5db",
        "400": "#9ca3af",
        "500": "#6b7280",
        "600": "#4b5563",
        "700": "#374151",
        "800": "#1f2937",
        "900": "#111827",
        "950": "#0d1117",
        "DEFAULT": "#6b7280"
      }
    },
    "darkMode": "class",
    "borderRadius": {
      "xl": "12px",
      "2xl": "16px"
    }
  },

  // ─────────────────────────────────────────────
  // 10. MISC OBSERVATIONS
  // ─────────────────────────────────────────────
  "observations": {
    "cardShadow": "Very subtle — shadow-sm only. No harsh elevation.",
    "inputHeight": "All inputs and oauth buttons share the same 40px height for visual rhythm.",
    "ctaHeight": "CTA button is 44px — 4px taller than inputs, gives it visual weight.",
    "borderRadius": "Inputs: rounded-lg (8px). CTA: rounded-xl (12px). Card: rounded-2xl (16px). Progression from tight → loose as elements get larger.",
    "googleIcon": "Must use the official multi-color Google SVG — not a monochrome icon. The 4 colors are part of the brand requirement.",
    "githubIcon": "Standard GitHub Octocat SVG. Use fill-current so it adapts to dark mode text color.",
    "passwordEyeIcon": "Positioned absolutely inside the input wrapper. Toggles between eye and eye-off icon.",
    "ctaArrow": "Small trailing arrow/chevron in the Continue button. Subtle — white/80 opacity.",
    "noCustomFont": "No evidence of a custom font. System font stack (Inter / -apple-system / sans-serif) is a safe match.",
    "formValidation": "Not visible in screenshot but implied: inline error messages should appear below each field in text-red-500 text-xs.",
    "spacing": "Section spacing between heading block / oauth group / divider / fields / checkbox / cta is consistently 24px (space-y-6)."
  }
}
